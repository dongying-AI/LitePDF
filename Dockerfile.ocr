# LitePDF OCR 服务 — PaddleOCR-VL
# 基础镜像较大（含 PaddlePaddle），首次构建约 5-10 分钟
FROM python:3.10-slim

WORKDIR /app

# 替换为清华镜像源（加速 apt/pip）
RUN sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list

# 安装系统依赖（仅图形库，无需编译工具）
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx libglib2.0-0 libsm6 libxext6 libxrender-dev libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖（全走国内镜像）
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --no-cache-dir --default-timeout=300 \
    flask flask-cors pillow numpy && \
    pip install --no-cache-dir --default-timeout=600 \
    paddlepaddle -i https://www.paddlepaddle.org.cn/packages/stable/cpu/ && \
    pip install --no-cache-dir --default-timeout=300 \
    paddleocr

# 复制 OCR 服务代码
COPY ocr_server.py ./

# 预热 PaddleOCR 模型（首次启动时下载）
RUN python -c "from paddleocr import PaddleOCR; ocr = PaddleOCR(lang='ch'); print('PaddleOCR ready')"

EXPOSE 5000

CMD ["python", "ocr_server.py"]
